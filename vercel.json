{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/api/blog?slug=:slug" },
    { "source": "/downloads", "destination": "/downloads.html" },
    { "source": "/people", "destination": "/people.html" },
    { "source": "/youtube", "destination": "/youtube.html" }
  ]
}
